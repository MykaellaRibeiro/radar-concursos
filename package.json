    "collect:predicted": "tsx --env-file-if-exists=.env.local scripts/collect-predicted.ts",
    "collect:documents": "tsx --env-file-if-exists=.env.local scripts/collect-documents.ts",
    "parse:exam": "tsx --env-file-if-exists=.env.local scripts/parse-exam.ts",
    "check:pci": "tsx scripts/check-pci.ts",
    "test:exa": "tsx --env-file-if-exists=.env.local scripts/check-exa.ts",
    "validate:auth": "tsx --env-file-if-exists=.env.local scripts/validate-auth-rls.ts",
    "validate:phase3": "tsx --env-file-if-exists=.env.local scripts/validate-phase3.ts",
    "validate:phase4": "tsx --env-file-if-exists=.env.local scripts/validate-phase4.ts",
    "validate:phase5": "tsx --env-file-if-exists=.env.local scripts/validate-phase5.ts",
    "validate:phase6": "tsx --env-file-if-exists=.env.local scripts/validate-phase6.ts",
    "validate:phase7": "tsx --env-file-if-exists=.env.local scripts/validate-phase7.ts",
    "ops:status": "tsx --env-file-if-exists=.env.local scripts/ops-status.ts",
    "ops:health": "tsx --env-file-if-exists=.env.local scripts/ops-health.ts",
    "smoke": "tsx --env-file-if-exists=.env.local scripts/smoke.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
